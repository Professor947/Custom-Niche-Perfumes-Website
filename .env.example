# Copy to .env.local and fill in. Never commit .env.local.

# ---------- Business details (public — shown on the site) ----------
NEXT_PUBLIC_BRAND_NAME="Atelier Noor"            # [BRAND_NAME]
NEXT_PUBLIC_CITY="Lahore"                        # [CITY]
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"    # email shown in the footer
NEXT_PUBLIC_WHATSAPP_NUMBER="+923000000000"      # [WHATSAPP_NUMBER], +92 format
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-handle/consultation"  # [CALENDLY_URL]
NEXT_PUBLIC_MIN_LEAD_TIME_WEEKS=6                # [MIN_LEAD_TIME_WEEKS]
NEXT_PUBLIC_MIN_ORDER_QTY=0                      # [MIN_ORDER_QTY], 0 = no minimum
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/your-handle"
NEXT_PUBLIC_INSTAGRAM_HANDLE="@your-handle"
NEXT_PUBLIC_SITE_URL="https://your-domain.pk"    # used for canonical URLs, OG and JSON-LD

# ---------- Server-only secrets ----------
OWNER_EMAIL="you@your-domain.pk"                 # [OWNER_EMAIL] — where new briefs are sent
RESEND_API_KEY=""                                # https://resend.com/api-keys (if empty in dev, emails print to the console)
EMAIL_FROM="Atelier Noor <briefs@your-domain.pk>" # must be on a domain verified in Resend

# Optional: Google Apps Script web-app URL; each brief is appended as a row. Leave empty to skip.
GOOGLE_SHEETS_WEBHOOK_URL=""
